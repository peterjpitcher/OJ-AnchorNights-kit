{
  "name": "@anchor-nights/kit",
  "version": "2.1.0",
  "description": "Shared look, TV, sign-in and engineering kit for The Anchor's game nights (Quiz Night, Cash Bingo, Music Bingo, Tasting Night).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterjpitcher/OJ-AnchorNights-kit.git"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./branding": {
      "types": "./src/branding/index.ts",
      "default": "./src/branding/index.ts"
    },
    "./dates": {
      "types": "./src/dates/index.ts",
      "default": "./src/dates/index.ts"
    },
    "./env": {
      "types": "./src/env/index.d.ts",
      "default": "./src/env/index.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./qr": {
      "types": "./src/qr/index.ts",
      "default": "./src/qr/index.ts"
    },
    "./tv": {
      "types": "./src/tv/index.ts",
      "default": "./src/tv/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    },
    "./events/shared": {
      "types": "./src/events/shared.ts",
      "default": "./src/events/shared.ts"
    },
    "./events/fixtures": {
      "types": "./src/events/fixtures.ts",
      "default": "./src/events/fixtures.ts"
    },
    "./events/image-host": {
      "types": "./src/events/image-host.d.ts",
      "default": "./src/events/image-host.js"
    },
    "./promo": {
      "types": "./src/promo/index.ts",
      "default": "./src/promo/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    "./auth/shared": {
      "types": "./src/auth/shared.ts",
      "default": "./src/auth/shared.ts"
    },
    "./auth/screens": {
      "types": "./src/auth/screens/index.ts",
      "default": "./src/auth/screens/index.ts"
    },
    "./auth/proxy": {
      "types": "./src/auth/proxy.ts",
      "default": "./src/auth/proxy.ts"
    },
    "./auth/headers": {
      "types": "./src/auth/headers.d.ts",
      "default": "./src/auth/headers.js"
    },
    "./auth/sql": {
      "types": "./src/auth/sql/index.d.ts",
      "default": "./src/auth/sql/index.js"
    },
    "./pairing": {
      "types": "./src/pairing/index.ts",
      "default": "./src/pairing/index.ts"
    },
    "./pairing/shared": {
      "types": "./src/pairing/shared.ts",
      "default": "./src/pairing/shared.ts"
    },
    "./pairing/screens": {
      "types": "./src/pairing/screens/index.ts",
      "default": "./src/pairing/screens/index.ts"
    },
    "./pairing/sql": {
      "types": "./src/pairing/sql/index.d.ts",
      "default": "./src/pairing/sql/index.js"
    },
    "./front": {
      "types": "./src/front/index.ts",
      "default": "./src/front/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/London vitest run",
    "test:utc": "TZ=UTC vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:utc",
    "test:db": "bash test/db/run.sh"
  },
  "peerDependencies": {
    "lucide-react": "^1.49.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "@supabase/ssr": ">=0.10.0",
    "@supabase/supabase-js": ">=2.101.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@supabase/ssr": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "nosleep.js": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
