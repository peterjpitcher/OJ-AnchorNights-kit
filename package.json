{
  "name": "@anchor-nights/kit",
  "version": "0.1.0",
  "description": "Shared look, TV and engineering kit for The Anchor's game nights (Quiz Night, Cash Bingo, Music Bingo, Tasting Night).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterjpitcher/OJ-AnchorNights-kit.git"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Europe/London vitest run",
    "test:utc": "TZ=UTC vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:utc"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
